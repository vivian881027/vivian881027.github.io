    <item>
      <title>文学作品中的恋父情结 01</title>
      <link>http://localhost:1313/posts/2026/03/%E6%96%87%E5%AD%A6%E4%BD%9C%E5%93%81%E4%B8%AD%E7%9A%84%E6%81%8B%E7%88%B6%E6%83%85%E7%BB%93-01/</link>
