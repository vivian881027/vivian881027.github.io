    <item>
      <title>浮士德式出发：在已知的世界里寻找未知的自己</title>
      <link>http://localhost:1313/posts/2026/03/%E6%B5%AE%E5%A3%AB%E5%BE%B7%E5%BC%8F%E5%87%BA%E5%8F%91%E5%9C%A8%E5%B7%B2%E7%9F%A5%E7%9A%84%E4%B8%96%E7%95%8C%E9%87%8C%E5%AF%BB%E6%89%BE%E6%9C%AA%E7%9F%A5%E7%9A%84%E8%87%AA%E5%B7%B1/</link>
      <pubDate>Tue, 17 Mar 2026 19:27:18 +0800</pubDate>
