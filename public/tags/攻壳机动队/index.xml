    <item>
      <title>银座没有夜晚：灵魂的USB接口</title>
      <link>http://localhost:1313/posts/2026/03/%E9%93%B6%E5%BA%A7%E6%B2%A1%E6%9C%89%E5%A4%9C%E6%99%9A%E7%81%B5%E9%AD%82%E7%9A%84usb%E6%8E%A5%E5%8F%A3/</link>
