    <item>
      <title>【剧本】麂皮与存在：雨天本体论</title>
      <link>http://localhost:1313/posts/2026/04/%E5%89%A7%E6%9C%AC%E9%BA%82%E7%9A%AE%E4%B8%8E%E5%AD%98%E5%9C%A8%E9%9B%A8%E5%A4%A9%E6%9C%AC%E4%BD%93%E8%AE%BA/</link>
